# ============================================================
# The Safari Edit — credentials for the enquiry plumbing
# ------------------------------------------------------------
# Copy this file to ".env.local" and fill in the real values.
# ".env.local" is git-ignored, so your secrets never leave your
# machine or get committed. Do NOT put real keys in THIS file.
# ============================================================

# --- Resend (sends the two emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The address the test email is sent FROM. Must be on a domain
# verified in your Resend account (thesafariedit.com).
RESEND_FROM="The Safari Edit <enquiries@thesafariedit.com>"

# --- Mailchimp (marketing opt-ins) ---
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-usXX
# The last part of your API key after the dash (e.g. us21) OR
# the prefix shown in your Mailchimp dashboard URL.
MAILCHIMP_SERVER_PREFIX=usXX
# Your audience / list ID (Audience > Settings > "Unique id").
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# --- Google Sheets (logs every enquiry) ---
# The ENTIRE service-account JSON file, pasted on ONE line, in
# single quotes. (Open the .json Google gave you, copy all of it.)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", ...}'
# The Sheet ID — the long code in your sheet's URL between
# /d/  and  /edit .  Make sure the sheet is SHARED (Editor) with
# the service account's client_email above.
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Test only ---
# Where the Resend test email should land so you can confirm it
# arrived. Use an inbox you can check.
TEST_EMAIL_TO=you@example.com
